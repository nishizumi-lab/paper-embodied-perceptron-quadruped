          <joint name="RL_thigh_joint" type="hinge" pos="0 0 0" axis="0 1 0" range="-0.52 4.54"/>
          <body name="RL_calf" pos="0 0 -0.213">
            <geom name="RL_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.213" size="0.018" mass="0.24" rgba="0.25 0.25 0.28 1"/>
            <joint name="RL_calf_joint" type="hinge" pos="0 0 0" axis="0 1 0" range="-2.72 -0.84" armature="0.024" damping="0.8" frictionloss="0.15"/>
            <geom name="RL_foot" type="sphere" pos="0 0 -0.213" size="0.025" mass="0.06" rgba="0.9 0.2 0.2 1"/>
          </body>
        </body>
      </body>

      <!-- RR leg (Rear Right) -->
      <body name="RR_hip" pos="-0.193 -0.047 0">
        <geom name="RR_hip_geom" type="cylinder" size="0.046 0.02" quat="0.707 0.707 0 0" mass="0.68" rgba="0.3 0.3 0.35 1"/>
        <joint name="RR_hip_joint" type="hinge" pos="0 0 0" axis="1 0 0" range="-1.05 1.05"/>
        <body name="RR_thigh" pos="0 -0.095 0">
          <geom name="RR_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.213" size="0.025" mass="1.15" rgba="0.75 0.75 0.78 1"/>
          <joint name="RR_thigh_joint" type="hinge" pos="0 0 0" axis="0 1 0" range="-0.52 4.54"/>
          <body name="RR_calf" pos="0 0 -0.213">
            <geom name="RR_calf_geom" type="capsule" fromto="0 0 0 0 0 -0.213" size="0.018" mass="0.24" rgba="0.25 0.25 0.28 1"/>
            <joint name="RR_calf_joint" type="hinge" pos="0 0 0" axis="0 1 0" range="-2.72 -0.84" armature="0.024" damping="0.8" frictionloss="0.15"/>
            <geom name="RR_foot" type="sphere" pos="0 0 -0.213" size="0.025" mass="0.06" rgba="0.9 0.2 0.2 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="FL_hip" joint="FL_hip_joint" ctrlrange="-24 24"/>
    <motor name="FL_thigh" joint="FL_thigh_joint" ctrlrange="-24 24"/>
    <motor name="FL_calf" joint="FL_calf_joint" ctrlrange="-45 45"/>
    <motor name="FR_hip" joint="FR_hip_joint" ctrlrange="-24 24"/>
    <motor name="FR_thigh" joint="FR_thigh_joint" ctrlrange="-24 24"/>
    <motor name="FR_calf" joint="FR_calf_joint" ctrlrange="-45 45"/>
    <motor name="RL_hip" joint="RL_hip_joint" ctrlrange="-24 24"/>
    <motor name="RL_thigh" joint="RL_thigh_joint" ctrlrange="-24 24"/>
    <motor name="RL_calf" joint="RL_calf_joint" ctrlrange="-45 45"/>
    <motor name="RR_hip" joint="RR_hip_joint" ctrlrange="-24 24"/>
    <motor name="RR_thigh" joint="RR_thigh_joint" ctrlrange="-24 24"/>
    <motor name="RR_calf" joint="RR_calf_joint" ctrlrange="-45 45"/>
