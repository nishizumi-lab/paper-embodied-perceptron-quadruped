            <joint name="FR_calf_joint" type="hinge" pos="0 0 0" axis="0 1 0" range="-2.72 -0.84" armature="0.024" damping="0.8" frictionloss="0.15"/>
            <geom name="FR_foot" type="sphere" pos="0 0 -0.213" size="0.025" mass="0.06" rgba="0.9 0.2 0.2 1"/>
          </body>
        </body>
      </body>

      <!-- RL leg (Rear Left) -->
      <body name="RL_hip" pos="-0.193 0.047 0">
        <geom name="RL_hip_geom" type="cylinder" size="0.046 0.02" quat="0.707 0.707 0 0" mass="0.68" rgba="0.3 0.3 0.35 1"/>
        <joint name="RL_hip_joint" type="hinge" pos="0 0 0" axis="1 0 0" range="-1.05 1.05"/>
